{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jungial.local/schemas/session_bundle.schema.json",
  "title": "SessionBundleV1",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "sessionId",
    "dominantArchetype",
    "coherence",
    "vibeState",
    "recentSymbols",
    "recentActions",
    "roomConfigSnapshot",
    "archetypeVector"
  ],
  "properties": {
    "schema": { "const": "SessionBundleV1" },
    "schemaVersion": { "const": 1 },
    "sessionId": { "type": "string" },
    "dominantArchetype": { "type": "string" },
    "coherence": { "type": "number", "minimum": 0, "maximum": 1 },
    "vibeState": { "type": "string" },
    "recentSymbols": { "type": "array", "items": { "type": "string" } },
    "recentActions": { "type": "array", "items": { "type": "string" } },
    "roomConfigSnapshot": { "type": "object" },
    "selectedDream": { "type": ["object", "null"] },
    "archetypeVector": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "dreamerMemoryContext": { "$ref": "dreamer_memory_context.schema.json" },
    "dreamJourneyContext": { "$ref": "#/$defs/dreamJourneyContext" },
    "dreamWeatherContext": {
      "type": "object",
      "required": [
        "schema",
        "schemaVersion",
        "weatherTags",
        "pressure",
        "dreadBudget",
        "suppressedTags"
      ],
      "properties": {
        "schema": { "const": "DreamWeatherContextV1" },
        "schemaVersion": { "const": 1 },
        "weatherTags": { "type": "array", "items": { "$ref": "#/$defs/weatherTag" } },
        "pressure": { "enum": ["low", "medium", "heavy", "storm"] },
        "dreadBudget": { "$ref": "dread_budget.schema.json" },
        "suppressedTags": { "type": "array", "items": { "$ref": "#/$defs/weatherTag" } }
      },
      "additionalProperties": false
    },
    "sessionCovenant": { "$ref": "session_covenant.schema.json" },
    "passageContext": {
      "type": "object",
      "properties": {
        "schema": { "const": "PassageContextV1" },
        "schemaVersion": { "const": 1 },
        "recentMotifs": { "type": "array", "items": { "type": "string" } },
        "recentGestureTags": { "type": "array", "items": { "type": "string" } },
        "activePassageId": { "type": ["string", "null"] },
        "echoThreadIds": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "dreamJourneyContext": {
      "type": "object",
      "required": [
        "schema",
        "schemaVersion",
        "symbolTrail",
        "suppressedModuleIds",
        "replacementRoutes",
        "fallbackUsed"
      ],
      "properties": {
        "schema": { "const": "DreamJourneyContextV1" },
        "schemaVersion": { "const": 1 },
        "symbolTrail": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "suppressedModuleIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "replacementRoutes": {
          "type": "array",
          "items": { "$ref": "#/$defs/dreamJourneyReplacementRoute" }
        },
        "fallbackUsed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "dreamJourneyReplacementRoute": {
      "type": "object",
      "required": ["blockedId", "selectedId", "carriedTags", "suppressedTags", "reason"],
      "properties": {
        "blockedId": { "type": "string", "minLength": 1 },
        "selectedId": { "type": "string", "minLength": 1 },
        "carriedTags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "suppressedTags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "weatherTag": {
      "enum": [
        "silence",
        "threshold",
        "soft_lamp",
        "mirror",
        "ash",
        "mist",
        "static",
        "gravity",
        "garden",
        "warmth",
        "cold",
        "distant_voice",
        "watching",
        "boundless",
        "contained",
        "pursuit",
        "bodyUnease",
        "cosmicDread",
        "disorientation",
        "loss",
        "claustrophobia",
        "annihilation",
        "rebirth",
        "cosmic_mystery",
        "reflection",
        "shadow",
        "self_observation",
        "safety",
        "memory",
        "hearth",
        "containment",
        "growth",
        "innocence",
        "fertility",
        "beauty",
        "dissolution",
        "void",
        "star",
        "unknown",
        "invitation",
        "door",
        "breath",
        "lamp"
      ]
    }
  }
}
