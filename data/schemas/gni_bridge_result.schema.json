{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jungial.local/schemas/gni_bridge_result.schema.json",
  "title": "GniBridgeResultV1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "source",
    "request",
    "rawResponse",
    "directive",
    "errors"
  ],
  "properties": {
    "schema": { "const": "GniBridgeResultV1" },
    "status": {
      "enum": [
        "invalid_session",
        "pending",
        "provider_empty",
        "provider_error",
        "directive_ready"
      ]
    },
    "source": {
      "enum": ["none", "provided", "provider", "emulator"]
    },
    "request": {
      "type": ["object", "null"]
    },
    "rawResponse": {
      "type": ["object", "null"]
    },
    "directive": {
      "type": ["object", "null"]
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": { "status": { "const": "directive_ready" } }
      },
      "then": {
        "properties": {
          "rawResponse": { "type": "object" },
          "directive": { "type": "object" }
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": {
            "enum": ["invalid_session", "pending", "provider_empty", "provider_error"]
          }
        }
      },
      "then": {
        "properties": {
          "directive": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": { "status": { "const": "provider_error" } }
      },
      "then": {
        "properties": {
          "errors": { "minItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
