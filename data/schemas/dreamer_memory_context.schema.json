{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jungial.local/schemas/dreamer_memory_context.schema.json",
  "title": "DreamerMemoryContextV1",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "profileId",
    "slotId",
    "saveMode",
    "sessionCount",
    "strongSymbols",
    "recurringArchetypes",
    "familiarMasks",
    "familiarDreamModules",
    "familiarActions",
    "familiarPassages",
    "familiarMotifs",
    "familiarGestures",
    "echoThreadIds",
    "vibeEchoes",
    "lastSessionDigest"
  ],
  "properties": {
    "schema": { "const": "DreamerMemoryContextV1" },
    "schemaVersion": { "const": 1 },
    "profileId": { "type": ["string", "null"] },
    "slotId": { "type": "string", "minLength": 1 },
    "saveMode": { "enum": ["fresh", "continue", "new_incarnation"] },
    "sessionCount": { "type": "integer", "minimum": 0 },
    "strongSymbols": { "$ref": "#/$defs/stringList" },
    "recurringArchetypes": { "$ref": "#/$defs/stringList" },
    "familiarMasks": { "$ref": "#/$defs/stringList" },
    "familiarDreamModules": { "$ref": "#/$defs/stringList" },
    "familiarActions": { "$ref": "#/$defs/stringList" },
    "familiarPassages": { "$ref": "#/$defs/stringList" },
    "familiarMotifs": { "$ref": "#/$defs/stringList" },
    "familiarGestures": { "$ref": "#/$defs/stringList" },
    "echoThreadIds": { "$ref": "#/$defs/stringList" },
    "vibeEchoes": { "$ref": "#/$defs/stringList" },
    "familiarWeatherTags": { "$ref": "#/$defs/weatherTagList" },
    "familiarDreadAxes": { "$ref": "#/$defs/dreadAxisList" },
    "lastSessionDigest": { "type": ["string", "null"] }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "weatherTagList": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "silence",
          "threshold",
          "soft_lamp",
          "mirror",
          "ash",
          "mist",
          "static",
          "gravity",
          "garden",
          "warmth",
          "cold",
          "distant_voice",
          "watching",
          "boundless",
          "contained",
          "pursuit",
          "bodyUnease",
          "cosmicDread",
          "disorientation",
          "loss",
          "claustrophobia",
          "annihilation",
          "rebirth",
          "cosmic_mystery",
          "reflection",
          "shadow",
          "self_observation",
          "safety",
          "memory",
          "hearth",
          "containment",
          "growth",
          "innocence",
          "fertility",
          "beauty",
          "dissolution",
          "void",
          "star",
          "unknown",
          "invitation",
          "door",
          "breath",
          "lamp"
        ]
      }
    },
    "dreadAxisList": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pursuit",
          "bodyUnease",
          "cosmicDread",
          "disorientation",
          "loss",
          "watching",
          "claustrophobia"
        ]
      }
    }
  }
}
