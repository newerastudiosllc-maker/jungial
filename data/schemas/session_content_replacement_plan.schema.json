{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jungial.local/schemas/session_content_replacement_plan.schema.json",
  "title": "SessionContentReplacementPlanV1",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "planId",
    "sourceGateId",
    "status",
    "avoidTags",
    "blockedReasons",
    "replacementHints",
    "replacement",
    "routes",
    "playerFacingText"
  ],
  "properties": {
    "schema": { "const": "SessionContentReplacementPlanV1" },
    "schemaVersion": { "const": 1 },
    "planId": { "type": "string", "minLength": 1 },
    "sourceGateId": { "type": ["string", "null"] },
    "status": { "enum": ["not_needed", "replacement_required"] },
    "avoidTags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blockedReasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "replacementHints": {
      "type": "object",
      "required": [
        "preferredToneTags",
        "allowedPressureTags",
        "passageIntensityBand",
        "weatherPressure",
        "returnAnchorKind",
        "groundingPreference"
      ],
      "properties": {
        "preferredToneTags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "allowedPressureTags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "passageIntensityBand": {
          "enum": ["gentle", "strange", "dark", "horrific", "abyssal", "cathartic", "beautiful", "chaotic"]
        },
        "weatherPressure": { "enum": ["low", "medium", "heavy", "storm"] },
        "returnAnchorKind": { "type": "string", "minLength": 1 },
        "groundingPreference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "replacement": {
      "type": "object",
      "required": ["passage", "dreamWeather", "maskId"],
      "properties": {
        "passage": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "passage.schema.json" }
          ]
        },
        "dreamWeather": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "dream_weather.schema.json" }
          ]
        },
        "maskId": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "action", "selectedId", "reason"],
        "properties": {
          "target": { "enum": ["passage", "dreamWeather", "mask"] },
          "action": { "enum": ["replace", "suppress"] },
          "selectedId": { "type": ["string", "null"] },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "playerFacingText": { "type": "null" }
  },
  "additionalProperties": false
}
