{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jungial.local/schemas/save_game.schema.json",
  "title": "JungialSaveGame",
  "type": "object",
  "required": ["schema", "version", "savedAt", "migrations", "payload"],
  "properties": {
    "schema": { "const": "JungialSaveGame" },
    "version": { "const": 1 },
    "savedAt": { "type": "string" },
    "migrations": { "type": "array", "items": { "type": "string" } },
    "payload": {
      "type": "object",
      "required": ["room", "archetypeState", "feelingState", "journal", "architectState"],
      "properties": {
        "room": { "type": "object" },
        "archetypeState": { "type": "object" },
        "feelingState": { "type": "object" },
        "journal": { "type": "object" },
        "architectState": { "type": "object" },
        "gniQueue": { "type": "object" },
        "lastSessionBundle": { "type": "object" },
        "pendingGniRequest": { "type": "object" },
        "gniBridgeResult": { "type": "object" },
        "appliedGniDirective": { "type": ["object", "null"] },
        "lastGniQueueProcessResult": { "type": "object" },
        "dreamerProfile": { "$ref": "dreamer_profile.schema.json" },
        "sessionCovenant": { "$ref": "session_covenant.schema.json" },
        "echoTrace": { "$ref": "echo_trace.schema.json" },
        "dreamWeather": { "$ref": "dream_weather.schema.json" },
        "weatherTrace": { "$ref": "weather_trace.schema.json" },
        "trace": { "$ref": "trace.schema.json" }
      }
    }
  }
}
