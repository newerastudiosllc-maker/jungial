{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jungial.local/schemas/save_game.schema.json",
  "title": "JungialSaveGame",
  "type": "object",
  "required": ["schema", "version", "savedAt", "payload"],
  "properties": {
    "schema": { "const": "JungialSaveGame" },
    "version": { "const": 1 },
    "savedAt": { "type": "string" },
    "migrations": { "type": "array", "items": { "type": "string" } },
    "payload": { "type": "object" }
  }
}
